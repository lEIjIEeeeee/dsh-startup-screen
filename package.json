{
  "name": "dsh-startup-screen",
  "version": "1.5.0",
  "description": "DeepSeek Harness 启动界面与启动动画：黑幕标识 → 过曝洗白 → 暖白档案底板 → 五步访问授权 → 色散揭幕。Canvas 活体光场、真实 DSH 版本与运行数据、真声台词与界面音效、液态玻璃、暗/浅双主题。设置页按播放 / 外观 / 声音 / 内容 / 关于五页组织，共 39 项，保存后下次启动生效。web 与桌面端通用；Windows 桌面端播放期间标题栏自动透明，结束后还原。本仓库为 6shenhonghong9/dsh-startup-screen 的 fork，视觉方案参考 QIFANAI/dsh-startup-screen v1.6.0（MIT）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "startup",
    "splash",
    "boot-animation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "docs/screenshots",
    "preview/index.html",
    "open-preview.sh",
    "打开预览.cmd",
    "安装.cmd",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "pretest": "npm run build",
    "test:unit": "tsx --test \"test/unit/*.test.mjs\"",
    "test": "npm run test:unit && tsx test/smoke-host.mjs && tsx test/smoke-splash.mjs && tsx test/smoke-client.mjs && tsx test/smoke-desktop-boot.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run size",
    "release:check": "node scripts/release.mjs",
    "prepublishOnly": "npm run verify"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lEIjIEeeeee/dsh-startup-screen.git"
  },
  "bugs": {
    "url": "https://github.com/lEIjIEeeeee/dsh-startup-screen/issues"
  },
  "homepage": "https://github.com/lEIjIEeeeee/dsh-startup-screen#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "lEIjIEeeeee",
  "contributors": [
    "沈宏宏 (original author)",
    "QIFANAI (visual design reference)"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
